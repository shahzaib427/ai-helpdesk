# ---- Service ----
APP_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# ---- LLM provider ----
# Swappable at runtime: echo | (later) groq, ollama, openai-compatible...
LLM_PROVIDER=echo
LLM_API_KEY=
LLM_BASE_URL=
MODEL_NAME=echo-1
LLM_TIMEOUT_SECONDS=60

# ---- RAG (Phase 5) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store
DOCUMENTS_PATH=./data/documents
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
RELEVANCE_THRESHOLD=0.35

# ---- Node backend (tools call back into it) ----
BACKEND_URL=http://localhost:5000
